# Database Configuration
# NOTE: Rotate your Supabase password if it was ever exposed in public repos or logs.
# Format for PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

